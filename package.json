{
  "name": "interview-prep-kit",
  "version": "0.1.0",
  "private": true,
  "description": "AI Interview Prep Kit — turns a job description + company URL into a personalised interview prep kit.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "evaluate": "tsx apps/backend/src/evaluate.ts",
    "evaluate:real": "tsx apps/backend/src/evaluate-real.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.7.5",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "vitest": "^2.1.3"
  }
}
