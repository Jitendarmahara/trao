# ─────────────────────────────────────────────────────────────────────────────
# AI Interview Prep Kit — environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM (OpenAI-compatible client: base URL + key + model) ──
# The SUBMISSION default is a GENUINE FREE-TIER provider, so a clean clone runs
# with no paid account. Example below uses Groq's free tier.
#   Get a free key: https://console.groq.com  → API Keys → Create
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_free_tier_key_here
LLM_MODEL=llama-3.3-70b-versatile
#
# Local-development alternative (DeepSeek — paid but very cheap). Same client,
# just different values — the app is NOT dependent on DeepSeek:
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_API_KEY=your_deepseek_key
#   LLM_MODEL=deepseek-chat

# ── Database ──
MONGODB_URI=mongodb://localhost:27017/interview_prep_kit

# ── Auth ──
# Long random string used to sign sessions. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string

# ── Server ──
PORT=4000

# ── Crawler / retrieval ──
# Allow loopback / localhost fetch targets. Required for the Section 9 batch,
# whose company sites may be served from a local address. Keep FALSE in production.
ALLOW_LOCAL_URLS=false
