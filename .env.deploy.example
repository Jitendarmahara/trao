# ─────────────────────────────────────────────────────────────────────────────
# Deployment env — copy to `.env` on the server, next to docker-compose.yml.
# docker compose reads THIS file for ${...} substitution. It is never copied
# into the image (see .dockerignore). Do NOT commit the real .env.
#
#   cp .env.deploy.example .env   &&   edit .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Auth ── long random string that signs sessions. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string

# ── LLM (OpenAI-compatible: base URL + key + model) ──
# The deployed instance uses DeepSeek — Groq's free tier is too rate-limited for
# the full pipeline during testing. Key: https://platform.deepseek.com
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your_deepseek_key_here
LLM_MODEL=deepseek-chat
#
# Groq free-tier alternative (light/local use):
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_API_KEY=your_groq_key
#   LLM_MODEL=openai/gpt-oss-120b     # (llama-3.3-70b-versatile was deprecated by Groq)

# NOTE: MONGODB_URI, PORT, NODE_ENV and ALLOW_LOCAL_URLS are set inside
# docker-compose.yml (Mongo runs as a service on the private network), so you
# do NOT set them here.
